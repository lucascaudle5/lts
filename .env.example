# Copy to .env.local and fill in. Never commit real values.
#   macOS/Linux: cp .env.example .env.local      Windows: copy .env.example .env.local
# `pnpm db:migrate`, `pnpm db:seed`, and `pnpm test:db` read .env.local (then .env) from the repo root
# themselves; `pnpm dev` / `pnpm build` load it through Next.js.
# Nothing here is required to run the M0 skeleton; each block notes the milestone that starts using it.
# Names match what the Vercel Marketplace Supabase integration syncs into Vercel, so
# `vercel env pull` and local values use the same keys.

# --- M1: database (values below are the local Supabase CLI stack from `supabase start`) ---
# Local Supabase Postgres: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Server-only. Runtime connection; in production this is the pooled (transaction mode) URL.
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Server-only. Used by `pnpm db:migrate`; in production this is the non-pooled URL.
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional. Local server `pnpm test:db` creates (and drops) its throwaway databases on; defaults to
# POSTGRES_URL_NON_POOLING. Must be localhost.
# TEST_DATABASE_URL=

# --- M2: auth (Supabase Auth, email/password) ---
# Public by design: the publishable key only allows auth calls because every table denies anon/authenticated roles.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The local stack's fixed default key, as printed by `supabase start` / `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Origin that password recovery links return to (<origin>/auth/confirm). Must match the URL you open the app on
# and be allowed in Supabase Auth → URL Configuration. Production: your production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:4317

# --- M4: AI harness ---
# mock = deterministic offline provider (default for dev, tests, CI).
# gateway = Vercel AI Gateway via the AI SDK.
LTS_AI_PROVIDER=mock
# Gateway model id in creator/model form, chosen from the AI Gateway model list.
LTS_AI_MODEL=
# Server-only. Local development only. On Vercel deployments leave it unset: the project's OIDC
# token (VERCEL_OIDC_TOKEN) is used automatically. Never prefix with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=
# metadata = keep only hashes, versions, tool calls, proposal ids (default; use in production).
# full = also store raw prompt/output text, deleted after LTS_AI_TRACE_RETENTION_DAYS.
LTS_AI_TRACE_MODE=metadata
LTS_AI_TRACE_RETENTION_DAYS=7
