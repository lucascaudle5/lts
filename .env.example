# Copy to .env.local and fill in. Never commit real values.
# Nothing here is required to run the M0 skeleton; each block notes the milestone that starts using it.

# --- M1: database (local Supabase stack prints these after `supabase start`) ---
# Server-only. Direct Postgres connection used by Drizzle migrations and server code.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- M2: auth (Supabase Auth) ---
# Public by design: the anon key only allows auth calls because every table denies anon/authenticated roles.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- M4: AI harness ---
# mock = deterministic offline provider (default for dev and tests).
# openai-compatible = any /chat/completions API (Groq, OpenAI, OpenRouter, local Ollama).
LTS_AI_PROVIDER=mock
# Only for openai-compatible. Example for Groq: https://api.groq.com/openai/v1
LTS_AI_BASE_URL=
# Model id at that endpoint, e.g. llama-3.3-70b-versatile
LTS_AI_MODEL=
# Server-only. Never prefix with NEXT_PUBLIC_.
LTS_AI_API_KEY=
