# Copy to .env.local and fill in. Never commit real values.
# Nothing here is required to run the M0 skeleton; each block notes the milestone that starts using it.

# --- M1: database (local Supabase stack prints these after `supabase start`) ---
# Server-only. Direct Postgres connection used by Drizzle migrations and server code.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- M2: auth (Supabase Auth) ---
# Public by design: the anon key only allows auth calls because every table denies anon/authenticated roles.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- M4: AI harness ---
# mock = deterministic offline provider (default for dev and tests). Real providers need a key below.
LTS_AI_PROVIDER=mock
# Model id passed to the selected provider, e.g. llama-3.3-70b-versatile (groq) or gpt-4.1-mini (openai).
LTS_AI_MODEL=
# Server-only. Set only the key for the provider you selected.
GROQ_API_KEY=
OPENAI_API_KEY=
